import os

if not os.path.exists("/content/Restormer"):
    !git clone https://github.com/swz30/Restormer.git

if not os.path.exists("/content/SwinIR"):
    !git clone https://github.com/JingyunLiang/SwinIR.git

# -----------------------------
# STEP 2: Install dependencies
# -----------------------------
!pip -q install timm einops opencv-python pillow matplotlib scikit-image

# -----------------------------
# STEP 3: Select image folder
# -----------------------------
# Change this to your folder path
# Example:
# image_folder = "/content/center"
# image_folder = "/content/scratch"

image_folder = "/content/test"

from PIL import Image
import matplotlib.pyplot as plt
import shutil
import glob
import numpy as np

# Find images
image_files = [f for f in os.listdir(image_folder)
               if f.lower().endswith((".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff"))]

if len(image_files) == 0:
    raise Exception("No images found in the folder!")

filename = image_files[0]
input_path = os.path.join(image_folder, filename)

# Load image
img = Image.open(input_path).convert("L")
img = img.resize((256, 256))

# Save resized image
working_image = "/content/input_image.png"
img.save(working_image)

plt.figure(figsize=(4,4))
plt.imshow(img, cmap="gray")
plt.title("Original Input")
plt.axis("off")
plt.show()

# ============================================================
# RESTORMER
# ============================================================

# -----------------------------
# STEP 4: Prepare Restormer input
# -----------------------------
os.makedirs("/content/Restormer/input_images", exist_ok=True)

shutil.copy(
    working_image,
    "/content/Restormer/input_images/input_image.png"
)

# -----------------------------
# STEP 5: Download Restormer weights
# -----------------------------
%cd /content/Restormer

os.makedirs("Denoising/pretrained_models", exist_ok=True)

if not os.path.exists("Denoising/pretrained_models/gaussian_gray_denoising_blind.pth"):
    !wget -O Denoising/pretrained_models/gaussian_gray_denoising_blind.pth \
    https://github.com/swz30/Restormer/releases/download/v1.0/gaussian_gray_denoising_blind.pth

# -----------------------------
# STEP 6: Run Restormer
# -----------------------------
!python demo.py \
    --task Gaussian_Gray_Denoising \
    --input_dir input_images \
    --result_dir results

# -----------------------------
# STEP 7: Load Restormer output
# -----------------------------
restormer_result = "/content/Restormer/results/Gaussian_Gray_Denoising/input_image.png"

restormer_img = Image.open(restormer_result).convert("L")

plt.figure(figsize=(4,4))
plt.imshow(restormer_img, cmap="gray")
plt.title("Restormer Output")
plt.axis("off")
plt.show()

# ============================================================
# SWINIR
# ============================================================

# -----------------------------
# STEP 8: Prepare SwinIR input
# -----------------------------
os.makedirs("/content/SwinIR/input_images", exist_ok=True)

shutil.copy(
    restormer_result,
    "/content/SwinIR/input_images/input_image.png"
)

# -----------------------------
# STEP 9: Download SwinIR weights
# -----------------------------
%cd /content/SwinIR

os.makedirs("model_zoo", exist_ok=True)

if not os.path.exists("model_zoo/004_grayDN_DFWB_s128w8_SwinIR-M_noise15.pth"):
    !wget -O model_zoo/004_grayDN_DFWB_s128w8_SwinIR-M_noise15.pth \
    https://github.com/JingyunLiang/SwinIR/releases/download/v0.0/004_grayDN_DFWB_s128w8_SwinIR-M_noise15.pth

# -----------------------------
# STEP 10: Run SwinIR
# -----------------------------
!python main_test_swinir.py \
    --task gray_dn \
    --noise 15 \
    --model_path model_zoo/004_grayDN_DFWB_s128w8_SwinIR-M_noise15.pth \
    --folder_gt /content/SwinIR/input_images

# -----------------------------
# STEP 11: Load SwinIR output
# -----------------------------
result_files = glob.glob("/content/SwinIR/results/**/*.*", recursive=True)

if len(result_files) == 0:
    raise Exception("No SwinIR output found!")

swinir_img = Image.open(result_files[0]).convert("L")

plt.figure(figsize=(4,4))
plt.imshow(swinir_img, cmap="gray")
plt.title("SwinIR Output")
plt.axis("off")
plt.show()

from PIL import Image
import numpy as np
from skimage.metrics import peak_signal_noise_ratio, structural_similarity

# Load the ORIGINAL clean image
original = Image.open("/content/grayscale-image.png").convert("L").resize((256,256))

# Load the NOISY image that you created
noisy = Image.open("/content/test/gaussian_noisy.png").convert("L").resize((256,256))

# Load the Restormer output
restored = Image.open("/content/Restormer/results/Gaussian_Gray_Denoising/input_image.png").convert("L").resize((256,256))

orig = np.array(original).astype(np.float32) / 255.0
noi = np.array(noisy).astype(np.float32) / 255.0
res = np.array(restored).astype(np.float32) / 255.0

print("Noisy PSNR:", peak_signal_noise_ratio(orig, noi))
print("Restormer PSNR:", peak_signal_noise_ratio(orig, res))

print("Noisy SSIM:", structural_similarity(orig, noi, data_range=1.0))
print("Restormer SSIM:", structural_similarity(orig, res, data_range=1.0))

# ============================================================
# COMPARISON
# ============================================================

fig, ax = plt.subplots(1,3, figsize=(15,5))

ax[0].imshow(img, cmap="gray")
ax[0].set_title("Original")
ax[0].axis("off")

ax[1].imshow(restormer_img, cmap="gray")
ax[1].set_title("Restormer")
ax[1].axis("off")

ax[2].imshow(swinir_img, cmap="gray")
ax[2].set_title("SwinIR")
ax[2].axis("off")

plt.tight_layout()
plt.show()

# ============================================================
# EVALUATION
# ============================================================

from skimage.metrics import peak_signal_noise_ratio, structural_similarity

orig = np.array(img).astype(np.float32)/255.0
rest = np.array(swinir_img.resize(img.size)).astype(np.float32)/255.0

psnr = peak_signal_noise_ratio(orig, rest)
ssim = structural_similarity(orig, rest, data_range=1.0)

print("="*50)
print("Adaptive Restoration Pipeline Completed Successfully")
print("="*50)
print(f"PSNR : {psnr:.2f} dB")
print(f"SSIM : {ssim:.4f}")
print("="*50)
